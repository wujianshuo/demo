(function(){
  var siteId = document.body.getAttribute('data-site');
  if (!siteId) return;
  var nav = document.getElementById('main-nav');
  if (!nav) return;

  // 容器页白名单：这些页面的左侧栏以 ?cat=<slug> 在页内切换子栏目，
  // 其下拉子栏目统一进入同一容器页（避免退化为图文列表详情页 lmxq.html?cat=<slug>）
  var CONTAINER_PAGES = ['business.html', 'news.html', 'party.html', 'zhuanti.html'];

  fetch('/api/public/' + siteId + '/categories')
    .then(function(r){ return r.json(); })
    .then(function(cats){
      var arr = Array.isArray(cats) ? cats : (cats.data || []);
      // 过滤导航栏目
      var navCats = arr.filter(function(c){ return c.is_nav; }).sort(function(a,b){ return (a.sort_order||0) - (b.sort_order||0); });
      if (!navCats.length) return;

          // 建子栏目映射
          var childrenMap = {};
          navCats.forEach(function(c){
            var pid = c.parent_id || 0;
            if (!childrenMap[pid]) childrenMap[pid] = [];
            childrenMap[pid].push(c);
          });

          function renderCat(id, depth){
            depth = depth || 0;
            var c = navCats.find(function(x){ return x.id===id; });
            if (!c) return '';
            var href = '#';
            if (c.page_url === 'business.html') {
              // 业务领域为容器页，仅作下拉父级，不作为可打开的单独页面
              href = 'javascript:;';
            } else if (c.page_url) {
              href = c.page_url;
            } else if (c.nav_type === 'LINK' && c.link_url) {
              href = c.link_url;
            } else if (c.nav_type === 'PAGE') {
              href = 'page.html?cat=' + encodeURIComponent(c.slug);
            } else if (c.nav_type === 'DYNAMIC') {
              // 动态：容器页 dynamic.html（结构同新闻中心），统一以 ?cat=<slug> 进入
              href = 'dynamic.html?cat=' + encodeURIComponent(c.slug);
            } else if (c.name === '品牌文化') {
              // 指向品牌理念，由品牌理念自身类型决定最终链接
              var target = navCats.find(function(x){ return x.name === '品牌理念'; });
              if (target) {
                if (target.nav_type === 'PAGE') { href = 'page.html?cat=' + encodeURIComponent(target.slug); }
                else if (target.nav_type === 'LINK' && target.link_url) { href = target.link_url; }
                else { href = 'lmxq.html?cat='+encodeURIComponent(target.slug); }
              } else { href = 'lmxq.html?cat='+encodeURIComponent(c.slug); }
            } else {
              href = 'lmxq.html?cat='+encodeURIComponent(c.slug);
            }
            var html = '<li><a href="' + href + '">' + c.name + '</a>';
            // 只渲染一级子栏目（depth=0时渲染dropdown，depth>=1时不递归）
            if (depth === 0) {
              var kids = childrenMap[c.id];
              if (kids && kids.length){
                html += '<ul class="dropdown">';
                kids.forEach(function(k){
                  var sub = navCats.find(function(x){ return x.id===k.id; });
                  if (!sub) return;
                  var subHref = '#';
                  // 与生成器保持一致：子栏目默认按自身配置生成干净链接，
                  // 不与父栏目地址拼接（父栏目 page_url 可能已带 ?cat=xxx）
                  if (sub.page_url) {
                    subHref = sub.page_url;
                  } else if (sub.nav_type === 'LINK' && sub.link_url) {
                    subHref = sub.link_url;
                  } else if (sub.nav_type === 'PAGE') {
                    subHref = 'page.html?cat=' + encodeURIComponent(sub.slug);
                  } else if (sub.nav_type === 'DYNAMIC') {
                    // 子栏目自身为动态：同样进入 dynamic.html 页内切换
                    subHref = 'dynamic.html?cat=' + encodeURIComponent(sub.slug);
                  } else if (CONTAINER_PAGES.indexOf((c.page_url||'').split('?')[0]) >= 0) {
                    // 容器页（业务领域 business.html / 新闻中心 news.html / 党的建设 party.html / 专题专栏 zhuanti.html）：
                    // 左侧栏以 ?cat=<slug> 在页内切换子栏目，故子栏目进入同一容器页，避免退化为图文列表详情页
                    // lmxq.html?cat=<slug>；父栏目 page_url 可能带 ?cat=xxx，判定时忽略查询参数
                    subHref = (c.page_url||'').split('?')[0] + '?cat=' + encodeURIComponent(sub.slug);
                  } else if (c.nav_type === 'DYNAMIC') {
                    // 父栏目为动态容器页：子栏目在 dynamic.html 内切换
                    subHref = 'dynamic.html?cat=' + encodeURIComponent(sub.slug);
                  } else {
                    subHref = 'lmxq.html?cat='+encodeURIComponent(sub.slug);
                  }
                  html += '<li><a href="' + subHref + '">' + sub.name + '</a></li>';
                });
                html += '</ul>';
              }
            }
            html += '</li>';
            return html;
          }

          // 清除旧的动态导航项，但保留首页不删
          var items = nav.querySelectorAll('li:not(.active)');
          items.forEach(function(el){
            if (el.querySelector('a[href="index.html"]')) return;
            el.remove();
          });

          // 渲染顶级栏目（跳过"首页"，因为模板已硬编码）
          var roots = childrenMap[0] || [];
          roots.forEach(function(c){
            if (c.slug === 'home' || c.name === '首页') return;
            var li = renderCat(c.id);
            if (li) nav.insertAdjacentHTML('beforeend', li);
          });

          // 根据当前页面高亮对应导航
          var path = window.location.pathname;
          var fname = path.split('/').pop();
          var highlightCat = document.body.getAttribute('data-root-cat-name') || '';
          if (!highlightCat) {
            // URL 路径匹配：通过 page_url 或已知映射识别对应栏目
            if (fname === 'index.html' || fname === '') highlightCat = '首页';
            else {
              var matched = navCats.find(function(c){ return c.page_url === fname; });
              if (matched) highlightCat = matched.name;
              else if (fname === 'global.html') highlightCat = '关于四航';
              else if (fname.indexOf('about-') === 0) highlightCat = '关于四航';
              else if (fname === 'dynamic.html') {
                // 动态页：按 ?cat 定位栏目，再上溯到顶级栏目做导航高亮
                var dq = new URLSearchParams(window.location.search).get('cat');
                var dcat = dq ? (arr.find(function(x){ return x.slug === dq; }) || arr.find(function(x){ return x.name === dq; })) : null;
                while (dcat && dcat.parent_id) {
                  var dparent = arr.find(function(x){ return x.id === dcat.parent_id; });
                  if (!dparent) break;
                  dcat = dparent;
                }
                if (dcat) highlightCat = dcat.name;
              }
            }
          }
          if (highlightCat) {
            var allA = nav.querySelectorAll('li > a');
            allA.forEach(function(a){
              if (a.textContent.trim() === highlightCat) {
                var li = a.parentElement;
                if (li && li.tagName === 'LI') {
                  li.classList.add('active');
                }
                a.style.color = 'var(--primary)';
                a.style.fontWeight = '700';
              }
            });
          }

          // 渲染完成后检测溢出
          checkNavOverflow();
    });

  // 逐项隐藏尾部放不下的栏目（宽屏生效，窄屏由CSS媒体查询控制）
  function checkNavOverflow() {
    if (window.innerWidth <= 768) return;
    var headerTop = document.querySelector('.header-top');
    var headerNav = document.querySelector('.header-nav');
    if (!headerTop || !headerNav) return;

    // 先全部恢复显示
    var allLis = nav.querySelectorAll('li');
    allLis.forEach(function(li){ li.style.display = ''; });

    // 强制重排后获取真实宽度
    var langSwitch = document.querySelector('.lang-switch');
    var langWidth = langSwitch ? langSwitch.offsetWidth + 64 : 96;
    var available = headerTop.offsetWidth - langWidth;
    var needed = headerNav.scrollWidth;

    // 从右往左逐个隐藏，直到不溢出（至少保留首页）
    for (var i = allLis.length - 1; i >= 1; i--) {
      if (needed <= available) break;
      allLis[i].style.display = 'none';
      needed = headerNav.scrollWidth;
    }
  }

  // 窗口大小变化时重新检测
  var resizeTimer;
  window.addEventListener('resize', function(){
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(checkNavOverflow, 150);
  });
})();
